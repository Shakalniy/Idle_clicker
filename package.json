{
  "name": "my-yandex-game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:yandex": "vite --mode yandex",
    "dev:vk": "vite --mode vk",
    "dev:tma": "vite --mode tma",
    "dev:web": "vite --mode web",
    "build": "tsc && vite build",
    "build:yandex": "tsc && vite build --mode yandex",
    "build:vk": "tsc && vite build --mode vk",
    "build:tma": "tsc && vite build --mode tma",
    "build:web": "tsc && vite build --mode web",
    "sync:android": "npm run build:web && cap sync android",
    "apk:debug": "npm run sync:android && set \"JAVA_HOME=C:\\Program Files\\Android\\Android Studio\\jbr\" && cd android && gradlew.bat assembleDebug",
    "apk:release": "npm run sync:android && set \"JAVA_HOME=C:\\Program Files\\Android\\Android Studio\\jbr\" && cd android && gradlew.bat bundleRelease",
    "android:open": "cap open android",
    "tg:menubutton": "node set_menu_button.mjs",
    "preview": "vite preview"
  },
  "devDependencies": {
    "puppeteer": "^25.13.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@vkontakte/vk-bridge": "^3.0.2",
    "phaser": "^4.2.1",
    "posthog-js": "^1.438.7"
  }
}
